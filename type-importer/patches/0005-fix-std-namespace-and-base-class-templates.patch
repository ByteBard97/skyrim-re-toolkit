+        // Strip a leading "std::" namespace qualifier from builtin integer typedef
+        // spellings (e.g. "std::uint32_t" -> "uint32_t"). Ghidra's DataTypeParser
+        // doesn't resolve "std::"-qualified names at all -- confirmed empirically:
+        // every plain std::uintN_t/std::intN_t field in CommonLibSSE-NG headers
+        // (an extremely common pattern -- e.g. TESForm::formFlags) was stuck as an
+        // unresolved dependency, blocking its containing struct from ever resolving,
+        // with no diagnostic pointing at this as the cause. Safe to strip
+        // unconditionally: this codebase's own types are never spelled with a
+        // "std::" prefix (they live in the RE:: namespace), so this can only ever
+        // match real standard-library builtins.
+        if (s.startsWith("std::")) {
+            s = s.substring("std::".length());
+            changed = true;
+        }
+
         return changed ? s : null;
     }
 
