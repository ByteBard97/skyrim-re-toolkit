+            CursorKind canonicalFieldDeclKind = (canonicalFieldDecl != null) ? canonicalFieldDecl.kind() : null;
+            if (canonicalFieldType.spelling() != null && canonicalFieldType.spelling().contains("<")
+                && (canonicalFieldDeclKind == CursorKind.STRUCT_DECL || canonicalFieldDeclKind == CursorKind.CLASS_DECL)) {
+                ParsedStructure inlineType = parseFieldsFromType(canonicalFieldType, category);
+                fields.add(new ParsedStructure.FieldInfo(
+                    fieldCursor.spelling(), null, isBitField, bitWidth, true, inlineType));
+                return Type.FieldVisitResult.CONTINUE;
+            }
+
+            // Otherwise, use the canonical type spelling, not the raw one:
+            // template members are commonly typed via a nested alias (e.g.
+            // stl::enumeration's own "using underlying_type = Underlying;"),
+            // which is never independently registered as a resolvable type
+            // anywhere -- clang_getCanonicalType resolves through it to the
+            // real underlying type (e.g. "unsigned short"), which Ghidra's
+            // DataTypeParser can actually find.
             fields.add(new ParsedStructure.FieldInfo(
-                fieldCursor.spelling(), fieldCursor.type().canonicalType().spelling(),
+                fieldCursor.spelling(), canonicalFieldType.spelling(),
                 isBitField, bitWidth, false, null));
             return Type.FieldVisitResult.CONTINUE;
         });
