     /**
+     * Determines whether a class/struct declaration is polymorphic -- i.e. has (or
+     * inherits) a vtable -- by checking for any virtual method or destructor
+     * declared directly on it, or recursing into its own base classes.
+     * <p>
+     * Used to decide whether a derived class needs a brand-new synthetic vptr
+     * field or whether its virtual methods extend an already-inherited vtable.
+     * See the fix note at the {@code allFields} construction site in
+     * {@link #parseStruct} for why this check exists.
+     */
+    private boolean isPolymorphic(Cursor classDecl) {
+        if (classDecl == null)
+            return false;
+
+        boolean[] found = {false};
+        List<Cursor> bases = new ArrayList<>();
+
+        classDecl.visitChildren((cursor, parent) -> {
+            if (found[0])
+                return Cursor.ChildVisitResult.BREAK;
+            switch (cursor.kind()) {
+                case C_X_X_METHOD, DESTRUCTOR -> {
+                    if (cursor.isVirtualMethod()) {
+                        found[0] = true;
+                        return Cursor.ChildVisitResult.BREAK;
+                    }
+                }
+                case C_X_X_BASE_SPECIFIER -> bases.add(cursor.type().declaration());
+                default -> {}
+            }
+            return Cursor.ChildVisitResult.CONTINUE;
+        });
+
+        if (found[0])
+            return true;
+
+        for (Cursor base : bases) {
+            if (isPolymorphic(base))
+                return true;
+        }
+        return false;
+    }
