+    /**
+     * Functional interface for visiting a type's direct fields.
+     */
+    @FunctionalInterface
+    public interface FieldVisitor {
+        FieldVisitResult visit(Cursor fieldCursor);
+    }
+
+    /** Result codes for field visitor callbacks (libclang's CXVisitorResult). */
+    public enum FieldVisitResult {
+        BREAK(0),
+        CONTINUE(1);
+
+        final int value;
+
+        FieldVisitResult(int v) {
+            this.value = v;
+        }
+    }
+
+    private static final ThreadLocal<FieldVisitor> CURRENT_FIELD_VISITOR = new ThreadLocal<>();
+    private static final ThreadLocal<Arena> CURRENT_FIELD_ARENA = new ThreadLocal<>();
+
+    /**
+     * Visit the direct fields of this type, invoking the visitor for each one.
+     * <p>
+     * Uses clang_Type_visitFields rather than {@code declaration().visitChildren(...)}
+     * because clang_visitChildren does NOT enumerate the member fields of an
+     * implicitly-instantiated class template specialization -- confirmed with a
+     * minimal libclang C program bypassing this Java layer entirely.
+     * clang_isCursorDefinition and clang_Type_getSizeOf both confirm such a type IS
+     * fully instantiated and complete; clang_visitChildren on its declaration cursor
+     * still finds zero children. clang_Type_visitFields (which walks
+     * CXXRecordDecl::field_begin()/field_end() directly) finds them correctly in the
+     * exact same case.
+     */
+    public void visitFields(FieldVisitor visitor) {
+        try (Arena upcallArena = Arena.ofConfined()) {
+            MethodHandle callback;
+            try {
+                callback = MethodHandles.lookup().findStatic(
+                    Type.class,
+                    "visitFieldsCallback",
+                    MethodType.methodType(int.class, MemorySegment.class, MemorySegment.class)
+                );
+            } catch (NoSuchMethodException | IllegalAccessException e) {
+                throw new RuntimeException("Failed to find visitFieldsCallback", e);
+            }
+
+            MemorySegment stub = LibClang.linker().upcallStub(
+                callback,
+                LibClang.FIELD_VISITOR_DESC,
+                upcallArena
+            );
+
+            FieldVisitor previousVisitor = CURRENT_FIELD_VISITOR.get();
+            Arena previousArena = CURRENT_FIELD_ARENA.get();
+            CURRENT_FIELD_VISITOR.set(visitor);
+            CURRENT_FIELD_ARENA.set(this.arena);
+            try {
+                LibClang.typeVisitFields(this.segment, stub, MemorySegment.NULL);
+            } finally {
+                if (previousVisitor != null) {
+                    CURRENT_FIELD_VISITOR.set(previousVisitor);
+                } else {
+                    CURRENT_FIELD_VISITOR.remove();
+                }
+                if (previousArena != null) {
+                    CURRENT_FIELD_ARENA.set(previousArena);
+                } else {
+                    CURRENT_FIELD_ARENA.remove();
+                }
+            }
+        }
+    }
+
+    @SuppressWarnings("unused") // Invoked via MethodHandles.lookup().findStatic() in visitFields()
+    private static int visitFieldsCallback(MemorySegment cursorSeg, MemorySegment clientData) {
+        try {
+            Arena arena = CURRENT_FIELD_ARENA.get();
+            FieldVisitor visitor = CURRENT_FIELD_VISITOR.get();
+
+            MemorySegment cursorCopy = arena.allocate(LibClang.CX_CURSOR);
+            cursorCopy.copyFrom(cursorSeg.reinterpret(LibClang.CX_CURSOR.byteSize()));
+
+            Cursor cursor = new Cursor(cursorCopy, arena);
+            return visitor.visit(cursor).value;
+        } catch (Throwable t) {
+            // MUST catch everything -- uncaught exceptions in upcalls terminate the JVM
+            t.printStackTrace();
+            return FieldVisitResult.BREAK.value;
+        }
+    }
