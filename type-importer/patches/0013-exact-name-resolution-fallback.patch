+    /**
+     * Exact-name DTM lookup that disambiguates same-named types across
+     * categories by preferring the category this pool's own parsed entry
+     * for the name was registered under (e.g. RE::Color's category over a
+     * Windows-SDK COLOR living elsewhere in the DTM).
+     */
+    private DataType findTypeByNamePreferringParsedCategory(String name) {
+        List<DataType> results = new ArrayList<>();
+        this.dtm.findDataTypes(name, results);
+        if (results.isEmpty())
+            return null;
+        if (results.size() > 1) {
+            ParsedType parsed = this.parsedTypes.get(name);
+            if (parsed != null) {
+                for (DataType dt : results) {
+                    if (dt.getCategoryPath() != null
+                        && dt.getCategoryPath().equals(parsed.getCategoryPath())) {
+                        return dt;
+                    }
+                }
+            }
+        }
+        return results.get(0);
+    }
