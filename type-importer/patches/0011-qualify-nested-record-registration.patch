+    /**
+     * Spelling to record for a field's type reference. When the referenced
+     * declaration is nested inside a record, the locally-printed sugared
+     * spelling is BARE (confirmed empirically: BGSSoundOutput's own `Data
+     * data;` field spells as "Data", while its canonical spelling is
+     * "RE::BGSSoundOutput::Data") and could never match the
+     * record-qualified registration key above -- so use the canonical
+     * (fully-qualified) spelling, which TypePool's progressive qualifier
+     * peeling resolves against the qualified key. Template spellings are
+     * left untouched (separate inline-embedding mechanism, patches
+     * 0003/0005), as are anonymous types.
+     */
+    private static String fieldTypeSpelling(Type t) {
+        String s = t.spelling();
+        if (s == null || s.contains("<")) {
+            return s;
+        }
+        Type u = t.unwrap();
+        int guard = 0;
+        while (guard++ < 8) {
+            TypeKind k = u.kind();
+            if (k == TypeKind.POINTER) {
+                u = u.pointeeType().unwrap();
+            } else if (k == TypeKind.CONSTANT_ARRAY) {
+                u = u.arrayElementType().unwrap();
+            } else {
+                break;
+            }
+        }
+        Cursor decl = u.declaration();
+        if (decl == null) {
+            return s;
+        }
+        CursorKind dk = decl.kind();
+        if (dk != CursorKind.STRUCT_DECL && dk != CursorKind.CLASS_DECL
+            && dk != CursorKind.UNION_DECL && dk != CursorKind.ENUM_DECL) {
+            return s;
+        }
+        Cursor parent = decl.semanticParent();
+        if (parent == null) {
+            return s;
+        }
+        CursorKind pk = parent.kind();
+        if (pk == CursorKind.STRUCT_DECL || pk == CursorKind.CLASS_DECL
+            || pk == CursorKind.UNION_DECL || pk == CursorKind.CLASS_TEMPLATE) {
+            String canon = t.canonicalType().spelling();
+            if (canon != null && !canon.isEmpty() && !canon.contains("<")
+                && !canon.contains("(anonymous")) {
+                return canon;
+            }
+        }
+        return s;
+    }
