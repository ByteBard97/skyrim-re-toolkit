+    /**
+     * Returns the cursor's name qualified by its chain of enclosing RECORD
+     * parents (classes/structs/unions) -- namespaces are deliberately
+     * excluded (they map to CategoryPath, not the registered name). E.g.
+     * the nested struct RE::BGSSoundOutput::Data registers as
+     * "BGSSoundOutput::Data", not "Data". 25 distinct RE:: classes declare
+     * an unrelated nested struct named "Data" (and many more collide on
+     * similar nested names): registering them all under the bare name lets
+     * whichever registers first (or has the most fields -- see
+     * TypePool.addParsedType's forward-decl heuristic) silently win every
+     * reference. Confirmed root cause of the BGSSoundOutput regression in
+     * patch 0009 and the same defect family blocking patch 0007. See
+     * patches/0011-qualify-nested-record-registration.md.
+     */
+    private static String recordQualifiedName(Cursor cursor) {
+        String name = cursor.spelling();
+        if (name == null || name.isEmpty()) {
+            return name;
+        }
+        StringBuilder sb = new StringBuilder(name);
+        Cursor parent = cursor.semanticParent();
+        int guard = 0;
+        while (parent != null && guard++ < 16) {
+            CursorKind k = parent.kind();
+            if (k != CursorKind.STRUCT_DECL && k != CursorKind.CLASS_DECL
+                && k != CursorKind.UNION_DECL && k != CursorKind.CLASS_TEMPLATE) {
+                break;
+            }
+            String p = parent.spelling();
+            if (p == null || p.isEmpty()) {
+                break;
+            }
+            sb.insert(0, p + "::");
+            parent = parent.semanticParent();
+        }
+        return sb.toString();
+    }
